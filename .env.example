# -----------------------------------------------------------------------------
# PrintFlow environment variables — copy to .env.local (never commit real values)
# -----------------------------------------------------------------------------

# Supabase (Project Settings → API). The publishable/anon key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret/service-role key. Required for marketplace sync & cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of this deployment (used for OAuth redirect URLs and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key (64 hex chars) used to encrypt marketplace tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shared secret that authorises the scheduled sync endpoint (/api/cron/sync).
# Generate with: openssl rand -hex 24
CRON_SECRET=

# --- Etsy Open API v3 (https://www.etsy.com/developers/your-apps) -----------
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
# Must exactly match a callback URL registered on your Etsy app:
ETSY_REDIRECT_URI=http://localhost:3000/api/integrations/etsy/callback

# --- Shopify Admin GraphQL API ---------------------------------------------
# your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Option A: an app installed via OAuth (Dev Dashboard app): client id + secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: an existing Admin API access token (legacy custom app)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
